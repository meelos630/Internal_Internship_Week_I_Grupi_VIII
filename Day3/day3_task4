#include <stdio.h>

int main() {
    int a;
    float b;

    // Input
    printf("Shkruaj nje numer integer: ");
    scanf("%d", &a);

    printf("Shkruaj nje numer float: ");
    scanf("%f", &b);

    // Pointers
    int *pA = &a;
    float *pB = &b;

    // Print fillestar
    printf("\n--- Vlerat fillestare ---\n");
    printf("a = %d, adresa = %p, vlera nga pointer = %d\n", a, pA, *pA);
    printf("b = %.2f, adresa = %p, vlera nga pointer = %.2f\n", b, pB, *pB);

    // Ruaj vlerat para ndryshimit
    int oldA = a;
    float oldB = b;

    // Ndryshim me pointer
    *pA = *pA + 10;
    *pB = *pB * 2;

    // Print pas ndryshimit
    printf("\n--- Pas ndryshimit ---\n");
    printf("a = %d (ishte %d)\n", a, oldA);
    printf("b = %.2f (ishte %.2f)\n", b, oldB);

    // Kontroll me if/else
    printf("\n--- Analiza ---\n");

    if (a > oldA) {
        printf("a eshte rritur.\n");
    } else if (a < oldA) {
        printf("a eshte zvogeluar.\n");
    } else {
        printf("a ka mbetur e njejte.\n");
    }

    if (b > oldB) {
        printf("b eshte rritur.\n");
    } else if (b < oldB) {
        printf("b eshte zvogeluar.\n");
    } else {
        printf("b ka mbetur e njejte.\n");
    }

    // Kontroll intervali
    if (a >= 0 && a <= 100) {
        printf("a eshte brenda intervalit 0 - 100.\n");
    } else {
        printf("a eshte jashte intervalit 0 - 100.\n");
    }

    return 0;
}
