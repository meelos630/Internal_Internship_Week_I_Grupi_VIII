#include <stdio.h>

int main() {
    int a;
    double b;

    // Input
    printf("Shkruaj nje numer integer: ");
    scanf("%d", &a);

    printf("Shkruaj nje numer double: ");
    scanf("%lf", &b);

    // Pointer
    int *pA = &a;
    double *pB = &b;

    // Print fillestar
    printf("\n--- Vlerat fillestare ---\n");
    printf("a = %d | adresa = %p | nga pointer = %d\n", a, &a, *pA);
    printf("b = %.2lf | adresa = %p | nga pointer = %.2lf\n", b, &b, *pB);

    // Ruaj vlerat fillestare
    int oldA = a;
    double oldB = b;

    // Ndryshim permes pointer
    *pA = *pA + 5;
    *pB = *pB - 2.5;

    // Print pas ndryshimit
    printf("\n--- Pas ndryshimit ---\n");
    printf("a i ri = %d | ishte = %d\n", a, oldA);
    printf("b i ri = %.2lf | ishte = %.2lf\n", b, oldB);

    // Analiza me if/else
    printf("\n--- Analiza ---\n");

    if (a > oldA) {
        printf("a eshte rritur.\n");
    } else if (a < oldA) {
        printf("a eshte zvogeluar.\n");
    } else {
        printf("a nuk ka ndryshuar.\n");
    }

    if (b > oldB) {
        printf("b eshte rritur.\n");
    } else if (b < oldB) {
        printf("b eshte zvogeluar.\n");
    } else {
        printf("b nuk ka ndryshuar.\n");
    }

    // Kontroll intervali
    if (a >= -10 && a <= 50) {
        printf("a eshte brenda intervalit [-10, 50]\n");
    } else {
        printf("a eshte jashte intervalit [-10, 50]\n");
    }

    return 0;
}
