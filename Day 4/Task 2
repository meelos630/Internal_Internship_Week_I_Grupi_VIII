// enum për status
typedef enum {
    NOT_STARTED = 1,
    IN_PROGRESS,
    COMPLETED
} Status;

// struktura
typedef struct {
    int id;
    char name[50];
    float progress;
    Status status;
} Student;

// funksion për zgjedhjen e statusit me validim
Status chooseStatus() {
    int choice;

    while (1) {
        printf("\nZgjidh statusin:\n");
        printf("1. Not Started\n");
        printf("2. In Progress\n");
        printf("3. Completed\n");
        printf("Zgjedhja: ");
        scanf("%d", &choice);

        switch (choice) {
            case 1: return NOT_STARTED;
            case 2: return IN_PROGRESS;
            case 3: return COMPLETED;
            default:
                printf(" Zgjedhje e pavlefshme! Provo perseri.\n");
        }
    }
}

// shto student
void addStudent(Student *students, int *count) {
    if (*count >= MAX_STUDENTS) {
        printf(" Kapaciteti maksimal u arrit!\n");
        return;
    }

    Student s;

    printf("Shkruaj ID: ");
    scanf("%d", &s.id);

    printf("Shkruaj emrin: ");
    scanf("%s", s.name);

    printf("Shkruaj progresin (0-100): ");
    scanf("%f", &s.progress);

    if (s.progress < 0 || s.progress > 100) {
        printf("Progres i pavlefshem!\n");
        return;
    }

    // përdor enum për status
    s.status = chooseStatus();

    students[*count] = s;
    (*count)++;

    printf(" Studenti u shtua me sukses!\n");
}

// shfaq studentet
void displayStudents(Student *students, int count) {
    if (count == 0) {
        printf("Nuk ka studente.\n");
        return;
    }

    printf("\n--- Lista ---\n");

    for (int i = 0; i < count; i++) {
        printf("ID: %d\n", students[i].id);
        printf("Emri: %s\n", students[i].name);
        printf("Progresi: %.2f%%\n", students[i].progress);

        printf("Statusi: ");
        switch (students[i].status) {
            case NOT_STARTED: printf("Not Started\n"); break;
            case IN_PROGRESS: printf("In Progress\n"); break;
            case COMPLETED: printf("Completed\n"); break;
            default: printf("Unknown\n");
        }

        printf("-------------------\n");
    }
}

int main() {
    Student students[MAX_STUDENTS];
    int count = 0;
    int choice;

    do {
        printf("\n===== MENU =====\n");
        printf("1. Shto student\n");
        printf("2. Shfaq studentet\n");
        printf("0. Dil\n");
        printf("Zgjedhja: ");
        scanf("%d", &choice);

        switch (choice) {
            case 1:
                addStudent(students, &count);
                break;
            case 2:
                displayStudents(students, count);
                break;
            case 0:
                printf("Programi u mbyll.\n");
                break;
            default:
                printf(" Zgjedhje e pavlefshme! Provo perseri.\n");
        }

    } while (choice != 0);

    return 0;
}
