#include <stdio.h>

int main() {
    int n, choice;

    // Marr input
    printf("Shkruaj madhesine (1 - 12): ");
    scanf("%d", &n);

    // Kontroll input
    if (n < 1 || n > 12) {
        printf("Input i pavlefshem!\n");
        return 0;
    }

    // Zgjedhja e pattern-it
    printf("Zgjidh pattern:\n");
    printf("1 - Yje\n");
    printf("2 - Numra\n");
    printf("Zgjedhja: ");
    scanf("%d", &choice);

    printf("\n");

    // Pattern me yje
    if (choice == 1) {
        for (int i = 1; i <= n; i++) {
            for (int j = 1; j <= i; j++) {
                printf("* ");
            }
            printf("\n");
        }
    }
    // Pattern me numra
    else if (choice == 2) {
        for (int i = 1; i <= n; i++) {
            for (int j = 1; j <= i; j++) {
                printf("%d ", j);
            }
            printf("\n");
        }
    }
    else {
        printf("Zgjedhje e pavlefshme!\n");
    }

    return 0;
}

