int main() {
    int a;
    float b;

    // Pointerat
    int *pA;
    float *pB;

    // Input
    printf("5: ");
    scanf("%d", &a);

    printf("3.14: ");
    scanf("%f", &b);

    // Caktimi i adresave
    pA = &a;
    pB = &b;

    // Shfaqja e vlerave dhe adresave
    printf("\n--- VLERAT FILLIMTARE ---\n");
    printf("Vlera e a: %d\n", a);
    printf("Adresa e a: %p\n", &a);
    printf("Vlera e a nga pointer: %d\n", *pA);

    printf("\nVlera e b: %.2f\n", b);
    printf("Adresa e b: %p\n", &b);
    printf("Vlera e b nga pointer: %.2f\n", *pB);

    // Ruaj vlerat e vjetra
    int oldA = a;
    float oldB = b;

    // Ndryshimi përmes pointerave
    *pA = *pA + 10;
    *pB = *pB * 2;

    // Output pas ndryshimit
    printf("\n--- PAS NDRYSHIMIT ---\n");
    printf("a para: %d, a pas: %d\n", oldA, a);
    printf("b para: %.2f, b pas: %.2f\n", oldB, b);

    // Kontroll me if/else për a
    printf("\n--- KONTROLLI PER a ---\n");
    if (a > oldA) {
        printf("Vlera e a eshte rritur.\n");
    } else if (a < oldA) {
        printf("Vlera e a eshte zvogeluar.\n");
    } else {
        printf("Vlera e a eshte e njejte.\n");
    }

    // Kontroll intervali për b
    printf("\n--- KONTROLLI PER b ---\n");
    if (b >= 0 && b <= 100) {
        printf("b eshte ne intervalin 0 - 100.\n");
    } else {
        printf("b eshte jashte intervalit 0 - 100.\n");
    }

    return 0;
}


